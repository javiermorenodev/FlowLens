{
  "name": "flowlens",
  "displayName": "FlowLens",
  "description": "Mapa visual en tiempo real de flujos Frontend -> API -> Backend -> Base de datos",
  "version": "0.0.1",
  "publisher": "flowlens",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowlens.open",
        "title": "FlowLens: Abrir Mapa de Flujo",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "flowlens.open",
          "when": "resourceLangId == typescript || resourceLangId == javascript || resourceLangId == vue",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "scan": "node dist/cli/scan.js",
    "github:bootstrap": "node scripts/github/bootstrap.mjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.24.7",
    "@babel/traverse": "^7.24.7",
    "@babel/types": "^7.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.3"
  }
}
